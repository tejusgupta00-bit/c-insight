{
  "name": "c-insight",
  "private": true,
  "version": "1.0.0",
  "description": "C-Insight: visualize C code structure, memory and execution",
  "author": "Your Name <you@example.com>",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:lan": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.js\"",
    "electron:dev": "concurrently -k -n VITE,ELECTRON \"vite --port 5173 --strictPort\" \"wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "npm run build && electron ."
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.cinsight.app",
    "productName": "C-Insight",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "server/**/*", "package.json"],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools"
    },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.12",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^9.5.1"
  }
}